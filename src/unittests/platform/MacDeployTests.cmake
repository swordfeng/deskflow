# Configure and install the real deployment rules with four synthetic Qt layouts.
# No compiler, signing identity, real Qt installation, or native app is involved.
foreach(layout framework dylib static missing)
  set(fixture "${TEST_BINARY_DIR}/${layout}")
  set(prefix "${fixture}/qt-prefix")
  set(Qt6_DIR "${fixture}/qt-config")
  file(MAKE_DIRECTORY "${prefix}/lib" "${Qt6_DIR}")
  file(WRITE "${prefix}/must-not-copy.txt" "outside the framework")
  set(target_type SHARED)
  set(framework_property FALSE)
  if(layout STREQUAL "framework")
    set(binary "${prefix}/lib/QtSvg.framework/Versions/Test/QtSvg")
    set(framework_property TRUE)
  elseif(layout STREQUAL "static")
    set(binary "${prefix}/lib/libQt6Svg.a")
    set(target_type STATIC)
  else()
    set(binary "${prefix}/lib/libQt6Svg.6.dylib")
  endif()
  get_filename_component(binary_dir "${binary}" DIRECTORY)
  file(MAKE_DIRECTORY "${binary_dir}")
  file(WRITE "${binary}" "mock library")
  if(layout STREQUAL "missing")
    set(config "set(Qt6_FOUND TRUE)\nset(Qt6Svg_FOUND FALSE)\n")
  else()
    string(CONFIGURE [[
set(Qt6_FOUND TRUE)
set(Qt6Svg_FOUND TRUE)
add_library(Qt6::Svg @target_type@ IMPORTED)
set_target_properties(Qt6::Svg PROPERTIES IMPORTED_LOCATION "@binary@" FRAMEWORK @framework_property@)
]] config @ONLY)
  endif()
  file(WRITE "${Qt6_DIR}/Qt6Config.cmake" "${config}")
  string(CONFIGURE [[
cmake_minimum_required(VERSION 3.24)
project(MacDeployFixture NONE)
set(BUILD_OSX_BUNDLE ON)
set(CMAKE_PROJECT_PROPER_NAME Deskflow)
set(BUILD_ARCHITECTURE arm64)
set(DEPLOYQT /usr/bin/true)
set(Qt6_DIR "@Qt6_DIR@")
include("@REPO_SOURCE_DIR@/deploy/mac/deploy.cmake")
]] project @ONLY)
  file(WRITE "${fixture}/CMakeLists.txt" "${project}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/build"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${layout} configure failed: ${output}\n${error}")
  endif()
  file(READ "${fixture}/build/cmake_install.cmake" plan)
  execute_process(COMMAND "${CMAKE_COMMAND}" --install "${fixture}/build" --prefix "${fixture}/installed"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${layout} install failed: ${output}\n${error}")
  endif()
  if(layout STREQUAL "framework")
    if(NOT EXISTS "${fixture}/installed/Deskflow.app/Contents/Frameworks/QtSvg.framework/Versions/Test/QtSvg"
        OR NOT plan MATCHES "QtSvg.framework/Versions/Test/QtSvg")
      message(FATAL_ERROR "Framework binary was not copied/deployed using its actual relative path")
    endif()
  else()
    file(GLOB_RECURSE installed "${fixture}/installed/*")
    if(installed OR plan MATCHES "QtSvg.framework")
      message(FATAL_ERROR "${layout} incorrectly seeded a framework: ${installed}")
    endif()
  endif()
endforeach()
